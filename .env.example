# ============================================================
# AI News Hub - Environment Configuration
# ============================================================

# Gemini AI Configuration
# Required for automated article summarization
GEMINI_API_KEY=

# Gemini Model to use (Current recommended: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# AI Provider: gemini (default) or ollama (for future local LLMs)
AI_PROVIDER=gemini

# Database URL (Default: SQLite file located in data directory)
DATABASE_URL=sqlite:///./data/news.db

# News Collection Interval (minutes)
NEWS_REFRESH_MINUTES=30

# Maximum age of articles to import from RSS (hours)
ARTICLE_MAX_AGE_HOURS=72

# Admin Dashboard Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Security secret for admin session cookies
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Application Base URL (for sitemaps and links)
BASE_URL=http://localhost:8000
